{
  "name": "geniechat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "dev:secure": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:setup": "tsx --env-file=.env scripts/setup-mongodb.ts",
    "db:setup:pg": "tsx --env-file=.env scripts/setup-postgres.ts",
    "db:setup:neo4j": "tsx --env-file=.env scripts/setup-neo4j.ts",
    "memory:check": "tsx --env-file=.env scripts/check-memory.ts",
    "memory:enrich": "tsx --env-file=.env scripts/enrich-memories.ts",
    "memory:migrate": "tsx --env-file=.env scripts/migrate-memories.ts",
    "schedules:migrate": "tsx --env-file=.env scripts/migrate-workflow-schedules.ts",
    "embeddings:check": "tsx --env-file=.env scripts/check-embeddings.ts",
    "knowledge:check": "tsx --env-file=.env scripts/check-knowledge.ts",
    "knowledge:backfill": "tsx --env-file=.env scripts/backfill-chunks.ts",
    "storage:check": "tsx --env-file=.env scripts/check-storage.ts",
    "ci:check": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@blocknote/core": "^0.51.0",
    "@blocknote/react": "^0.51.0",
    "@blocknote/shadcn": "^0.51.0",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-supervisor": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openrouter": "^0.4.13",
    "@langchain/textsplitters": "^1.0.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.100.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.20.0",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.2.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "katex": "^0.16.47",
    "langchain": "^1.4.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "mongodb": "^7.6.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "baseline-browser-mapping": "^2.10.30",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.2.6",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.3.2",
      "markdown-it": "14.1.1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
