# =============================================================================
# Environment Variables
# Copy to .env.local and fill in values.
# Required in production marked with [REQUIRED PROD].
# =============================================================================

# -----------------------------------------------------------------------------
# Auth — GitHub OAuth [REQUIRED PROD]
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_USERNAMES=            # comma-separated GitHub logins
GITHUB_MANAGER_USERNAMES=          # comma-separated GitHub logins
GITHUB_VIEWER_USERNAMES=           # comma-separated GitHub logins

# NextAuth [REQUIRED PROD]
NEXTAUTH_SECRET=                  # >= 32 chars random string
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MongoDB [REQUIRED] — required in every environment, including production
# -----------------------------------------------------------------------------
# Port 27018 is this project's isolated dev instance. 27017 is deliberately not
# used: that is where a developer's personal MongoDB conventionally runs, and a
# template defaulting to it invites `pnpm db:setup` and `pnpm dev` to write into
# an instance that has nothing to do with this app.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=geniechat              # optional, defaults to "geniechat"

# -----------------------------------------------------------------------------
# Security [REQUIRED PROD]
# -----------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=            # any strong random string — DO NOT rotate after data exists
CRON_SECRET=                      # any random string for cron job auth

# -----------------------------------------------------------------------------
# Ollama — chat models and embeddings
# -----------------------------------------------------------------------------
# Ollama Cloud (default). Get a key at https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# For a local server instead, drop the key and point at the daemon:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_API_KEY=

# Embedding model. Its output width must match EMBEDDING_VECTOR_DIMENSIONS
# (1536), which both Azure AI Search indexes declare. The indexes were built
# from OpenAI text-embedding-3-large vectors, so changing this model requires
# recreating those indexes and re-embedding existing content — vectors from
# different models are not comparable even at the same width.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Only set for models that accept a custom output width (e.g. embeddinggemma,
# qwen3-embedding). Most Ollama embedding models reject it.
# OLLAMA_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# External AI Providers
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Exa — powers the web_search tool. Get a key at https://dashboard.exa.ai
EXA_API_KEY=

# -----------------------------------------------------------------------------
# Object storage — self-hosted Garage (S3 API).  `docker compose up -d`
# -----------------------------------------------------------------------------
# Blank means "not configured": uploads return an ERROR response rather than
# failing boot.
S3_ENDPOINT=http://localhost:3900
# Only set this when the browser must reach a different address than the app —
# e.g. the app uses http://garage:3900 on a container network while the browser
# needs a public hostname. Presigned URLs are minted against this, because
# SigV4 signs the Host header. Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://storage.example.com
# Must match Garage's `s3_region`. Leave as "garage" unless that was changed.
S3_REGION=garage
S3_ACCESS_KEY_ID=                 # GK + 24 hex chars
S3_SECRET_ACCESS_KEY=             # 64 hex chars
# Leave true. A virtual-host presigned URL is https://<bucket>.<host>/…, which
# the browser cannot resolve without wildcard DNS.
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Azure Cognitive Search
# -----------------------------------------------------------------------------
AZURE_SEARCH_NAME=
AZURE_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Docling (self-hosted document parsing)
# -----------------------------------------------------------------------------
# Base URL of the docling-serve sidecar. Optional: when unset or unreachable,
# document parsing degrades to empty extraction and chat still works.
DOCLING_SERVE_URL=http://localhost:5001
# Only needed when the docling-serve sidecar is started with its own
# DOCLING_SERVE_API_KEY. The compose service sets none, so this stays blank
# locally; the app and the service read the same-named variable on their own
# sides of the wire.
DOCLING_SERVE_API_KEY=
# Transport backstop, enforced in the client with AbortSignal. Deliberately
# ABOVE the document_timeout the app sends per request (300s) and below
# DOCLING_SERVE_MAX_SYNC_WAIT (600s): the service's structured failure body is
# more useful than an AbortError, so this is a genuine backstop for a hung
# connection rather than the primary deadline. Defaults to 360000.
DOCLING_SERVE_TIMEOUT_MS=360000

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Required in production. One connection string covers host, port, auth and TLS:
#   redis://localhost:6379                 local Docker Redis (docker compose up -d)
#   redis://:password@host:6379            self-hosted with a password
#   rediss://host:6380                     TLS enabled
# Rate limiting fails open if this is unset outside production.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# App Config
# -----------------------------------------------------------------------------
DEEP_RESEARCH_MODEL=
NODE_ENV=development

# Local dev only — disable TLS verification for self-signed certs
# NODE_TLS_REJECT_UNAUTHORIZED=0
# NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1
# BROWSERSLIST_IGNORE_OLD_DATA=1
